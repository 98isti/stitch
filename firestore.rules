rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Test collection — remove before launch
    match /_test/{doc} {
      allow read, write: if true;
    }

    // Account data — only authenticated users belonging to that account
    match /accounts/{accountId} {
      allow read, write: if request.auth != null && request.auth.uid == accountId;
    }
    match /accounts/{accountId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == accountId;
    }

    // User profile mapping
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Item templates — any authenticated user can read (used during onboarding/new location setup)
    match /itemTemplates/{document=**} {
      allow read: if request.auth != null;
      allow write: if false; // admin only via Firebase console / server SDK
    }
  }
}
